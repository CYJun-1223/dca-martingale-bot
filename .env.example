# Copy to .env and fill in. Never commit .env or share it.
# Bitget API key: Futures trade + read ONLY, no withdrawal. Use a sub-account.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
# 1 = Bitget demo trading account
BITGET_DEMO=0

# dashboard login (web.js)
WEB_USER=admin
WEB_PASSWORD=
# WEB_HOST=0.0.0.0   # also listen on LAN / Tailscale (the phone app can then connect directly, no Cloudflare)
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# Binance API key: Futures trading ONLY, no withdrawal. Used by bots with broker "binance".
BINANCE_API_KEY=
BINANCE_API_SECRET=

# PostgreSQL holding all bot data (settings, state, trades). Local service; see README "Database".
DATABASE_URL=postgres://soxxbot:CHANGE_ME@127.0.0.1:5432/soxxbot
